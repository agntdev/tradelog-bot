[{"name":"guided trade entry saves a confirmed trade","steps":[{"send":{"text":"/new"},"expect":[{"method":"sendMessage","payload":{"text":"Send the ticker, for example AAPL."}}]},{"send":{"text":"AAPL"},"expect":[{"method":"sendMessage","payload":{"text":"Choose the trade type."}}]},{"send":{"callback":"trade:type:Long"},"expect":[{"method":"sendMessage","payload":{"text":"Send the position size."}}]},{"send":{"text":"10"},"expect":[{"method":"sendMessage","payload":{"text":"Send the entry price."}}]},{"send":{"text":"185"},"expect":[{"method":"sendMessage","payload":{"text":"Send the entry date as YYYY-MM-DD, or tap Today."}}]},{"send":{"text":"2026-07-27"},"expect":[{"method":"sendMessage","payload":{"text":"Send realized P&L, or tap Skip."}}]},{"send":{"text":"25"},"expect":[{"method":"sendMessage","payload":{"text":"Add a note, or tap Skip."}}]},{"send":{"text":"breakout"},"expect":[{"method":"sendMessage","payload":{"text":"Confirm this trade:\n\nAAPL · Long\nSize 10 at 185\nEntry 2026-07-27\nP&L +25.00"}}]},{"send":{"callback":"trade:yes"},"expect":[{"method":"editMessageText","payload":{"text":"Trade saved.\n\nAAPL · Long\nSize 10 at 185\nEntry 2026-07-27\nP&L +25.00"}}]}]}]
